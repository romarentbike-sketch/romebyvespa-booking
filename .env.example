# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # dalla dashboard Supabase > Project Settings > API (chiave SEGRETA, mai lato frontend)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...        # o sk_test_... in sviluppo
STRIPE_WEBHOOK_SECRET=whsec_...      # generato quando crei il webhook endpoint su Stripe

# --- Resend (email transazionali, opzionale ma consigliato) ---
RESEND_API_KEY=re_...
NOTIFY_EMAIL=info@romebyvespa.com     # dove ricevi notifica di ogni nuova prenotazione

# --- Admin ---
ADMIN_API_KEY=scegli-una-password-lunga-e-random   # protegge le route /admin/*

# --- Generale ---
PORT=3001
FRONTEND_URL=https://www.romebyvespa.com   # per i redirect di Stripe Checkout e CORS
